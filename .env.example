# ---------------------------------------------------------------------------
# CorruptIntel — environment configuration template
# Copy to .env and fill in real values. Never commit the filled-in .env.
# ---------------------------------------------------------------------------

# --- Database ---
# Primary role: full read/write on published + staging tables (API service, migrations).
DATABASE_URL=postgresql://corruptintel:corruptintel_dev_password@localhost:5432/corruptintel
# Restricted role used ONLY by the AI extraction path in the worker.
# INSERT/SELECT on staging tables only; SELECT-only on published tables.
# See docs/07_security_architecture.md §5.
AI_DATABASE_URL=postgresql://corruptintel_ai:corruptintel_ai_dev_password@localhost:5432/corruptintel

# --- Redis (job queue) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible; MinIO locally) ---
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=corruptintel_dev
OBJECT_STORAGE_SECRET_KEY=corruptintel_dev_secret
OBJECT_STORAGE_BUCKET=corruptintel-documents
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# --- Auth ---
SESSION_SECRET=replace_with_a_long_random_string
JWT_SECRET=replace_with_a_different_long_random_string
JWT_EXPIRY=8h

# --- LLM provider (provider-agnostic; see packages/ai in a later phase) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=   # optional, only if LLM_PROVIDER=openai

# --- OCR (for scanned documents) ---
OCR_PROVIDER=tesseract
# OCR_CLOUD_API_KEY=   # only if using a cloud OCR provider instead

# --- App ---
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
API_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# --- Seed admin (used once by packages/database/seed-admin.js) ---
SEED_ADMIN_EMAIL=admin@corruptintel.local
SEED_ADMIN_PASSWORD=change_me_immediately
